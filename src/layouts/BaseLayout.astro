---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props { title: string; description: string; image?: string; }
const { title, description, image } = Astro.props;
const [profileEntry] = await getCollection('profile');
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(withBase(image), Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ede6d8" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href={withBase('#main')}>跳到主要内容</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer profile={profileEntry.data} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
