---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

type PageType = 'website' | 'article';
type StructuredData = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: PageType;
  publishedAt?: Date | string;
  noindex?: boolean;
  structuredData?: StructuredData;
}

const {
  title,
  description,
  image = '/images/site/social-preview.png',
  imageAlt = '森林的视觉设计与 AI 工作流个人网站分享图',
  type = 'website',
  publishedAt,
  noindex = false,
  structuredData,
} = Astro.props;
const [profileEntry] = await getCollection('profile');
const hasContact = Boolean(profileEntry.data.email.trim() || profileEntry.data.wechatQr.trim());
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const publishedTime = publishedAt ? new Date(publishedAt).toISOString() : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ede6d8" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={withBase('favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={profileEntry.data.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href={withBase('#main')}>跳到主要内容</a>
    <Header hasContact={hasContact} />
    <main id="main"><slot /></main>
    <Footer profile={profileEntry.data} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
