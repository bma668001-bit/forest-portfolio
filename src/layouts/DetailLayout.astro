---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedAt?: Date | string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  backHref,
  backLabel,
  image,
  imageAlt,
  type,
  publishedAt,
  noindex,
  structuredData,
} = Astro.props;
---

<BaseLayout
  title={`${title} — AI WORKFLOW / VISUAL PRACTICE`}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type={type}
  publishedAt={publishedAt}
  noindex={noindex}
  structuredData={structuredData}
>
  <article class="detail shell" data-reveal>
    <a class="detail__back" href={withBase(backHref)}>← {backLabel}</a>
    <header>
      <slot name="meta" />
      <h1>{title}</h1>
      <p class="detail__summary">{description}</p>
    </header>
    <div class="detail__body"><slot /></div>
    <slot name="pagination" />
  </article>
</BaseLayout>
