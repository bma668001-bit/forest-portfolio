---
import type { CollectionEntry } from 'astro:content';
import DemoBadge from './DemoBadge.astro';
import SectionHeading from './SectionHeading.astro';
import VisualCard from './VisualCard.astro';
import WorkflowCard from './WorkflowCard.astro';
import { withBase } from '../lib/url';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  workflows: CollectionEntry<'workflows'>[];
  visuals: CollectionEntry<'visuals'>[];
  articles: CollectionEntry<'articles'>[];
  notes: CollectionEntry<'notes'>[];
}
const { profile, workflows, visuals, articles, notes } = Astro.props;
const date = (value: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(value);
const location = profile.location.trim();
const availability = profile.availability.trim();
const resumeUrl = profile.resumeUrl.trim();
const socialLinks = profile.socialLinks.filter(({ label, url }) => label.trim() && url.trim());
const hasContact = Boolean(profile.email.trim() || profile.wechatQr.trim());
---

{workflows.length > 0 && (
  <section class="home-section shell" data-reveal>
    <SectionHeading eyebrow="01 / SYSTEMS" title="工作流精选" href={withBase('workflows/')} linkLabel="全部工作流" />
    <div class="workflow-list">{workflows.map((entry, index) => <WorkflowCard entry={entry} index={index} />)}</div>
  </section>
)}

{visuals.length > 0 && (
  <section class="home-section shell" data-reveal>
    <SectionHeading eyebrow="02 / VISUALS" title="视觉实践" href={withBase('visuals/')} linkLabel="全部作品" />
    <div class="visual-feature-grid">{visuals.map((entry) => <VisualCard entry={entry} />)}</div>
  </section>
)}

<section class="legacy-band" aria-label="传统设计基础" data-reveal>
  <div class="shell legacy-band__inner">
    <p class="eyebrow">03 / FOUNDATION</p>
    <p class="legacy-band__word">PS<br />BEFORE AI</p>
    <div class="legacy-band__copy">
      <p>海报、电商主图、自媒体封面、活动排版与节日热点图。</p>
      <p>传统设计作品不会抢走主叙事，但会留下判断构图、字体和商业场景的基础。</p>
    </div>
  </div>
</section>

{(articles.length > 0 || notes.length > 0) && (
  <section class="home-section shell" data-reveal>
    <SectionHeading eyebrow="04 / NOTES" title="最近在想" href={withBase('thoughts/')} linkLabel="全部思考" />
    <div class="thought-preview">
      {articles[0] && (
        <a class="article-lead" href={withBase(`thoughts/${articles[0].id}/`)}>
          <span class="article-lead__meta">{date(articles[0].data.publishedAt)} <DemoBadge demo={articles[0].data.demo} /></span><h3>{articles[0].data.title}</h3><p>{articles[0].data.summary}</p>
        </a>
      )}
      {notes.length > 0 && <ol class="note-list">{notes.map((entry) => <li><span class="note-list__meta">{date(entry.data.publishedAt)} <DemoBadge demo={entry.data.demo} /></span><p>{entry.data.text}</p></li>)}</ol>}
    </div>
  </section>
)}

<section class="about-section" id="about" aria-labelledby="about-title" data-reveal>
  <div class="shell about-section__grid">
    <div><p class="eyebrow">05 / PROFILE</p><h2 id="about-title">关于与联系</h2></div>
    <div class="about-section__copy">
      <p class="about-section__lead">{profile.bio}</p><p>{profile.status}</p>
      <ol class="experience-list" aria-label="经历">
        {profile.experience.map((item) => (
          <li><span>{item.period}</span><p>{item.label}</p></li>
        ))}
      </ol>
      {(location || availability) && (
        <dl class="profile-facts">
          {location && <div data-profile-location><dt>所在地</dt><dd>{location}</dd></div>}
          {availability && <div data-profile-availability><dt>合作状态</dt><dd>{availability}</dd></div>}
        </dl>
      )}
      <ul class="tool-list" aria-label="核心工具">{profile.tools.map((tool) => <li>{tool}</li>)}</ul>
      {(resumeUrl || socialLinks.length > 0) && (
        <div class="profile-links">
          {resumeUrl && <a data-profile-resume href={withBase(resumeUrl)}>查看简历 ↗</a>}
          {socialLinks.length > 0 && (
            <ul data-profile-social-links aria-label="社交链接">
              {socialLinks.map((link) => <li><a href={withBase(link.url)}>{link.label} ↗</a></li>)}
            </ul>
          )}
        </div>
      )}
      {hasContact
        ? <a class="about-section__next" href={withBase('#contact')}>到联系方式 ↓</a>
        : <a class="about-section__next" href={withBase('visuals/')}>继续浏览视觉作品 ↗</a>}
    </div>
  </div>
</section>
