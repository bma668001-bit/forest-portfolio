---
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-brand" href={link('')}>AW / VP</a>
    <nav class="site-nav" aria-label="主导航" data-navigation data-open="false">
      <a href={link('workflows/')}>工作流</a>
      <a href={link('visuals/')}>视觉作品</a>
      <a href={link('thoughts/')}>思考</a>
      <a href={link('#about')}>关于</a>
    </nav>
    <a class="contact-anchor" href={link('#contact')}>联系 / CONTACT</a>
    <button class="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false" data-nav-toggle>菜单</button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-navigation]');

  const setOpen = (open: boolean) => {
    if (!button || !nav) return;
    nav.dataset.open = String(open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    button.textContent = open ? '关闭' : '菜单';
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
