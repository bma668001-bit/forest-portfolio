---
import { withBase } from '../lib/url';

interface Props { hasContact?: boolean; }
const { hasContact = false } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const relativePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname.replace(/^\//, '');
const section = relativePath.split('/').filter(Boolean)[0];
const currentSection = section === 'projects' ? 'visuals' : section;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-brand" href={withBase('')} aria-label="返回首页：AI 工作流与视觉设计个人作品集">AW / VP</a>
    <nav id="primary-navigation" class="site-nav" aria-label="主导航" data-navigation data-open="false">
      <a href={withBase('workflows/')} aria-current={currentSection === 'workflows' ? 'page' : undefined}>工作流</a>
      <a href={withBase('visuals/')} aria-current={currentSection === 'visuals' ? 'page' : undefined}>视觉作品</a>
      <a href={withBase('thoughts/')} aria-current={currentSection === 'thoughts' ? 'page' : undefined}>思考</a>
      <a href={withBase('/#about')}>关于</a>
    </nav>
    {hasContact && <a class="contact-anchor" href={withBase('/#contact')}>联系 / CONTACT</a>}
    <button class="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle>菜单</button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-navigation]');
  const desktop = window.matchMedia('(min-width: 961px)');

  const setOpen = (open: boolean, options: { moveFocus?: boolean; restoreFocus?: boolean } = {}) => {
    if (!button || !nav) return;
    const isOpen = open && !desktop.matches;
    const isHidden = !desktop.matches && !isOpen;

    nav.dataset.open = String(isOpen);
    nav.toggleAttribute('inert', isHidden);
    if (isHidden) nav.setAttribute('aria-hidden', 'true');
    else nav.removeAttribute('aria-hidden');
    button.setAttribute('aria-expanded', String(isOpen));
    button.setAttribute('aria-label', isOpen ? '关闭导航' : '打开导航');
    button.textContent = isOpen ? '关闭' : '菜单';
    if (isOpen) document.body.dataset.navigationOpen = 'true';
    else delete document.body.dataset.navigationOpen;

    if (isOpen && options.moveFocus) {
      nav.querySelector<HTMLAnchorElement>('a[href]')?.focus();
    }
    if (!isOpen && options.restoreFocus) button.focus();
  };

  button?.addEventListener('click', () => {
    const willOpen = button.getAttribute('aria-expanded') !== 'true';
    setOpen(willOpen, { moveFocus: willOpen });
  });
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (!button || !nav || button.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false, { restoreFocus: true });
      return;
    }
    if (event.key !== 'Tab') return;

    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href]')];
    const firstLink = links[0];
    const lastLink = links.at(-1);
    if (!firstLink || !lastLink) return;

    const activeElement = document.activeElement;
    if (event.shiftKey && activeElement === firstLink) {
      event.preventDefault();
      button.focus();
    } else if (event.shiftKey && activeElement === button) {
      event.preventDefault();
      lastLink.focus();
    } else if (!event.shiftKey && activeElement === lastLink) {
      event.preventDefault();
      button.focus();
    } else if (!event.shiftKey && activeElement === button) {
      event.preventDefault();
      firstLink.focus();
    }
  });
  desktop.addEventListener('change', () => setOpen(false));
  setOpen(false);
</script>
