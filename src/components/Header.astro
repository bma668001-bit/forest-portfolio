---
import { withBase } from '../lib/url';

interface Props { hasContact?: boolean; }
const { hasContact = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-brand" href={withBase('')}>AW / VP</a>
    <nav class="site-nav" aria-label="主导航" data-navigation data-open="false">
      <a href={withBase('workflows/')}>工作流</a>
      <a href={withBase('visuals/')}>视觉作品</a>
      <a href={withBase('thoughts/')}>思考</a>
      <a href={withBase('/#about')}>关于</a>
    </nav>
    {hasContact && <a class="contact-anchor" href={withBase('/#contact')}>联系 / CONTACT</a>}
    <button class="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false" data-nav-toggle>菜单</button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-navigation]');

  const setOpen = (open: boolean) => {
    if (!button || !nav) return;
    nav.dataset.open = String(open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    button.textContent = open ? '关闭' : '菜单';
    if (open) document.body.dataset.navigationOpen = 'true';
    else delete document.body.dataset.navigationOpen;
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
  const desktop = window.matchMedia('(min-width: 961px)');
  desktop.addEventListener('change', (event) => { if (event.matches) setOpen(false); });
</script>
