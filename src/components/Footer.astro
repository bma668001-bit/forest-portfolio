---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props { profile: CollectionEntry<'profile'>['data']; }
const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="shell">
    <div class="site-footer__grid">
      <div>
        <p class="eyebrow">OPEN FOR CONVERSATION / 保持联系</p>
        <h2>欢迎聊聊具体的问题。</h2>
      </div>
      <div class="site-footer__meta">
        <p>欢迎交流视觉、内容与工作流的具体问题。</p>
        {profile.email && <a href={withBase(`mailto:${profile.email}`)}>{profile.email}</a>}
        {profile.wechatQr && <img src={withBase(profile.wechatQr)} alt="微信联系二维码" width="180" height="180" loading="lazy" />}
        {!profile.email && !profile.wechatQr && <p>微信二维码整理后放在这里。</p>}
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} 森林 / VISUAL × AI WORKFLOW</span>
      <span>DESIGNED TO KEEP EVOLVING</span>
    </div>
  </div>
</footer>
