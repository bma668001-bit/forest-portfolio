---
import ResponsiveImage from './ResponsiveImage.astro';

interface CaseImage {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

interface Props {
  images: CaseImage[];
}

const { images } = Astro.props;
---

<section class="workflow-case-gallery" aria-labelledby="workflow-case-title">
  <p class="eyebrow">CASE STUDY / WORKFLOW</p>
  <h2 id="workflow-case-title">案例图解</h2>
  <div class="workflow-case-grid">
    {images.map((image, index) => (
      <figure class="workflow-case-card">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <ResponsiveImage {...image} sizes="(max-width: 767px) 92vw, 520px" loading={index === 0 ? 'eager' : 'lazy'} />
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    ))}
  </div>
</section>
