---
import ResponsiveImage from './ResponsiveImage.astro';

interface ProjectImage { src: string; alt: string; width: number; height: number; caption?: string; }
interface Props { images: ProjectImage[]; }
const { images } = Astro.props;
---

<div class="project-gallery" aria-label="项目图片">
  {images.map((image, index) => (
    <figure class="project-gallery__item">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <ResponsiveImage {...image} sizes="(max-width: 767px) 92vw, 520px" loading={index === 0 ? 'eager' : 'lazy'} />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  ))}
</div>
