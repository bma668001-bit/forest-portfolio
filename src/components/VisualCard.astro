---
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'visuals'>; }
const { entry } = Astro.props;
---

<figure class="visual-card" style={`--ratio:${entry.data.image.width}/${entry.data.image.height}`}>
  <div class="visual-card__image">
    <img src={entry.data.image.src} alt={entry.data.image.alt} width={entry.data.image.width} height={entry.data.image.height} loading="lazy" />
  </div>
  <figcaption><span>{entry.data.title}</span><span>{entry.data.category} / {entry.data.year}</span></figcaption>
</figure>
