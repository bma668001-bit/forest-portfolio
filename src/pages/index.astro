---
import { getCollection } from 'astro:content';
import HeroField from '../components/HeroField.astro';
import HomeSections from '../components/HomeSections.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { filterPublished, sortByOrder } from '../lib/content';

const [profileEntry] = await getCollection('profile');
const workflows = sortByOrder(filterPublished(await getCollection('workflows'))).filter((entry) => entry.data.featured);
const visuals = sortByOrder(filterPublished(await getCollection('visuals'))).filter((entry) => entry.data.featured).slice(0, 8);
const traditionalVisuals = sortByOrder(filterPublished(await getCollection('traditionalVisuals'))).filter((entry) => entry.data.featured).slice(0, 4);
const articles = filterPublished(await getCollection('articles')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const notes = filterPublished(await getCollection('notes')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3);
const title = '森林｜视觉设计与 AI 工作流实践';
const description = '森林的个人作品网站：5 年视觉设计经验，以及 AI 生图、内容生产和个人工作流实践。';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profileEntry.data.name,
  url: new URL(Astro.url.pathname, Astro.site).href,
  description,
  inLanguage: 'zh-CN',
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <HeroField role={profileEntry.data.role} status={profileEntry.data.status} />
  <HomeSections profile={profileEntry.data} workflows={workflows} visuals={visuals} traditionalVisuals={traditionalVisuals} articles={articles} notes={notes} />
</BaseLayout>
