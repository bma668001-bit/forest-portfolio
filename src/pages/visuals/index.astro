---
import { getCollection } from 'astro:content';
import Lightbox from '../../components/Lightbox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished, sortByOrder } from '../../lib/content';

const visuals = sortByOrder(filterPublished(await getCollection('visuals')));
const projects = filterPublished(await getCollection('projects'));
const projectById = new Map(projects.map((entry) => [entry.id, entry]));
const categories = ['全部', ...new Set(visuals.map((entry) => entry.data.category))];
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
---

<BaseLayout title="视觉作品 — AI WORKFLOW / VISUAL PRACTICE" description="海报、电商、自媒体、活动与 AI 场景视觉作品档案。">
  <header class="page-intro shell">
    <p class="eyebrow">VISUAL ARCHIVE / 持续更新</p>
    <h1>视觉作品</h1>
    <p>不同年代、不同工具与不同使用场景放在同一份视觉档案里。正式素材导入后，类别会由内容自动生成。</p>
  </header>
  <section class="gallery-section shell">
    <div class="gallery-filters" aria-label="作品分类">
      {categories.map((category, index) => <button type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}
    </div>
    <div class="gallery-grid" data-gallery>
      {visuals.map((entry) => (
        <figure class="gallery-item" data-visual data-category={entry.data.category} style={`--ratio:${entry.data.image.width}/${entry.data.image.height}`}>
          <button type="button" class="gallery-item__trigger" data-lightbox-trigger data-src={entry.data.image.src} data-alt={entry.data.image.alt} data-width={entry.data.image.width} data-height={entry.data.image.height} data-caption={`${entry.data.title} · ${entry.data.category} · ${entry.data.year}`}>
            <img src={entry.data.image.src} alt={entry.data.image.alt} width={entry.data.image.width} height={entry.data.image.height} loading="lazy" />
          </button>
          <figcaption>
            <span>{entry.data.title}</span><span>{entry.data.category} / {entry.data.year}</span>
            {entry.data.projectId && projectById.get(entry.data.projectId) && <a href={link(`projects/${entry.data.projectId}/`)} aria-label={`查看项目：${projectById.get(entry.data.projectId)?.data.title}`}>项目详情 ↗</a>}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="gallery-empty" data-gallery-empty hidden>这个分类暂时没有作品。</p>
  </section>
  <Lightbox />
  <script>
    import '../../scripts/gallery';
  </script>
</BaseLayout>
