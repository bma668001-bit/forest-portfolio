---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DemoBadge from '../../components/DemoBadge.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import DetailLayout from '../../layouts/DetailLayout.astro';
import { filterPublished, sortByOrder } from '../../lib/content';
import { withBase } from '../../lib/url';

interface Props { entry: CollectionEntry<'projects'>; previous?: CollectionEntry<'projects'>; next?: CollectionEntry<'projects'>; }

export async function getStaticPaths() {
  const entries = sortByOrder(filterPublished(await getCollection('projects')));
  return entries.map((entry, index) => ({ params: { id: entry.id }, props: { entry, previous: entries[index - 1], next: entries[index + 1] } }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const projectImage = new URL(withBase(entry.data.cover.src), Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description: entry.data.summary,
  url: canonical,
  dateCreated: String(entry.data.year),
  genre: entry.data.category,
  keywords: entry.data.tools,
  image: {
    '@type': 'ImageObject',
    contentUrl: projectImage,
    caption: entry.data.cover.alt,
    width: entry.data.cover.width,
    height: entry.data.cover.height,
  },
};
---

<DetailLayout
  title={entry.data.title}
  description={entry.data.summary}
  backHref="visuals/"
  backLabel="返回视觉作品"
  image={entry.data.cover.src}
  imageAlt={entry.data.cover.alt}
  structuredData={structuredData}
>
  <div slot="meta" class="detail-meta"><span>{entry.data.category}</span><span>{entry.data.year}</span><span>{entry.data.duration}</span><DemoBadge demo={entry.data.demo} /></div>
  <img class="project-cover" src={withBase(entry.data.cover.src)} alt={entry.data.cover.alt} width={entry.data.cover.width} height={entry.data.cover.height} />
  <dl class="project-facts">
    <div><dt>我的角色</dt><dd>{entry.data.role}</dd></div>
    <div><dt>使用工具</dt><dd>{entry.data.tools.join(' / ')}</dd></div>
  </dl>
  <div class="project-story"><Content /></div>
  <ProjectGallery images={entry.data.gallery} />
  <nav slot="pagination" class="detail-pagination" aria-label="相邻项目">
    {previous ? <a href={withBase(`projects/${previous.id}/`)}>← {previous.data.title}</a> : <span></span>}
    {next && <a href={withBase(`projects/${next.id}/`)}>{next.data.title} →</a>}
  </nav>
</DetailLayout>
