---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ProjectGallery from '../../components/ProjectGallery.astro';
import DetailLayout from '../../layouts/DetailLayout.astro';
import { filterPublished, sortByOrder } from '../../lib/content';

interface Props { entry: CollectionEntry<'projects'>; previous?: CollectionEntry<'projects'>; next?: CollectionEntry<'projects'>; }

export async function getStaticPaths() {
  const entries = sortByOrder(filterPublished(await getCollection('projects')));
  return entries.map((entry, index) => ({ params: { id: entry.id }, props: { entry, previous: entries[index - 1], next: entries[index + 1] } }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
---

<DetailLayout title={entry.data.title} description={entry.data.summary} backHref={link('visuals/')} backLabel="返回视觉作品">
  <div slot="meta" class="detail-meta"><span>{entry.data.category}</span><span>{entry.data.year}</span><span>{entry.data.duration}</span></div>
  <img class="project-cover" src={entry.data.cover.src} alt={entry.data.cover.alt} width={entry.data.cover.width} height={entry.data.cover.height} />
  <dl class="project-facts">
    <div><dt>我的角色</dt><dd>{entry.data.role}</dd></div>
    <div><dt>使用工具</dt><dd>{entry.data.tools.join(' / ')}</dd></div>
  </dl>
  <div class="project-story"><Content /></div>
  <ProjectGallery images={entry.data.gallery} />
  <nav slot="pagination" class="detail-pagination" aria-label="相邻项目">
    {previous ? <a href={link(`projects/${previous.id}/`)}>← {previous.data.title}</a> : <span></span>}
    {next && <a href={link(`projects/${next.id}/`)}>{next.data.title} →</a>}
  </nav>
</DetailLayout>
