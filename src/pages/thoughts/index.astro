---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished } from '../../lib/content';

const articles = filterPublished(await getCollection('articles')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const notes = filterPublished(await getCollection('notes')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
const date = (value: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(value);
---

<BaseLayout title="思考与灵感 — AI WORKFLOW / VISUAL PRACTICE" description="关于设计、AI 工作流与内容实践的文章和短灵感。">
  <header class="page-intro shell" data-reveal>
    <p class="eyebrow">NOTES & ARTICLES / 不定期记录</p>
    <h1>思考与灵感</h1>
    <p>不把这里写成教程仓库。只记录真实项目里值得留下的判断、失败、改法和偶然出现的念头。</p>
  </header>
  <div class="thoughts-page shell">
    {articles.length > 0 && (
      <section class="thoughts-block" aria-labelledby="articles-heading" data-reveal>
        <h2 id="articles-heading">文章</h2>
        <div class="article-index">
          {articles.map((entry, index) => (
            <a href={link(`thoughts/${entry.id}/`)}>
              <span>{String(index + 1).padStart(2, '0')} / {date(entry.data.publishedAt)}</span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </section>
    )}
    {notes.length > 0 && (
      <section class="thoughts-block" aria-labelledby="notes-heading" data-reveal>
        <h2 id="notes-heading">短灵感</h2>
        <ol class="notes-index">
          {notes.map((entry) => <li><time datetime={entry.data.publishedAt.toISOString()}>{date(entry.data.publishedAt)}</time><p>{entry.data.text}</p></li>)}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
