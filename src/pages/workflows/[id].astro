---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import { filterPublished, sortByOrder } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'workflows'>;
  previous?: CollectionEntry<'workflows'>;
  next?: CollectionEntry<'workflows'>;
  version?: CollectionEntry<'workflows'>;
}

export async function getStaticPaths() {
  const entries = sortByOrder(filterPublished(await getCollection('workflows')));
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: entries[index - 1],
      next: entries[index + 1],
      version: entry.data.versionOf ? entries.find((candidate) => candidate.id === entry.data.versionOf) : undefined,
    },
  }));
}

const { entry, previous, next, version } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
const statusLabel = { active: '每天使用', evolving: '持续优化', archived: '已归档' }[entry.data.status];
---

<DetailLayout title={entry.data.title} description={entry.data.summary} backHref={link('workflows/')} backLabel="返回工作流档案">
  <div slot="meta" class="detail-meta">
    <span>{entry.data.year}</span><span>{statusLabel}</span><span>{entry.data.tools.join(' / ')}</span>
  </div>
  <img class="detail-cover" src={entry.data.cover.src} alt={entry.data.cover.alt} width={entry.data.cover.width} height={entry.data.cover.height} />
  {version && <p class="version-link">由旧版本发展而来：<a href={link(`workflows/${version.id}/`)}>{version.data.title}</a></p>}
  <Content />
  <nav slot="pagination" class="detail-pagination" aria-label="相邻工作流">
    {previous ? <a href={link(`workflows/${previous.id}/`)}>← {previous.data.title}</a> : <span></span>}
    {next && <a href={link(`workflows/${next.id}/`)}>{next.data.title} →</a>}
  </nav>
</DetailLayout>
